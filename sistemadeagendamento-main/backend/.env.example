NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinic_db
DB_USER=clinic_user
DB_PASSWORD=clinic_password

# Development/test may use PostgreSQL without TLS. Production requires DB_SSL=true.
DB_SSL=false
# Set to a CA bundle path only when the PostgreSQL provider requires a custom CA.
# DB_SSL_CA_PATH=

# Gere um segredo aleatório com pelo menos 32 bytes antes de executar a API PHP.
JWT_SECRET=
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173
SESSION_COOKIE_SAME_SITE=lax

# Opcional: SMTP para recuperação de senha. Todos os valores devem ser configurados em conjunto.
# Em produção, PUBLIC_APP_URL precisa usar HTTPS.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_APP_URL=

# Checkout de planos e pagamentos pelo Mercado Pago. Nunca versionar tokens reais.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=

# Lembretes: SMTP usa as mesmas credenciais acima; WhatsApp requer API compatível com POST {to, message}.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
