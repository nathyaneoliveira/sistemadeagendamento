PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinic_db
DB_USER=clinic_user
DB_PASSWORD=clinic_password

# Development/test may use PostgreSQL without TLS. Production requires DB_SSL=true.
DB_SSL=false
# Set to a CA bundle path only when the PostgreSQL provider requires a custom CA.
# DB_SSL_CA_PATH=

# Optional credentials for local-only data scripts. Keep these empty by default.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
TEST_CLINIC_ID=
TEST_EMAIL=
TEST_PASSWORD=
# API_URL=http://localhost:4000/api

# Gere um segredo aleatório com pelo menos 32 bytes antes de executar o backend.
JWT_SECRET=
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAME_SITE=lax
