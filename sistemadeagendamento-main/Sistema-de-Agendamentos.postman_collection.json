  "item": [
    {
      "name": "Saúde",
      "item": [
        {
          "name": "Health - liveness",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200 e resposta de saúde', function () {", "  pm.response.to.have.status(200);", "  var body = pm.response.json();", "  pm.expect(body.ok).to.eql(true);", "  pm.expect(body).to.have.property('environment');", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "Health - readiness (consulta PostgreSQL)",
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Resposta de readiness em JSON', function () {", "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');", "  pm.expect([200, 503]).to.include(pm.response.code);", "  pm.expect(pm.response.json()).to.have.property('ok');", "});"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Autenticação clínica",
      "item": [
        {
          "name": "Login clínico",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login responde em JSON com envelope da API', function () {", "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403]);", "  var body = pm.response.json();", "  pm.expect(body).to.have.property('ok');", "  if (body.ok && body.data && body.data.token) {", "    pm.environment.set('token', body.data.token);", "    pm.environment.set('tokenClinicA', body.data.token);", "  }", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "Login Clinic B (salva token separado)",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clinicBLoginEmail}}\",\n  \"password\": \"{{clinicBLoginPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login Clinic B mantém token próprio', function () {", "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403]);", "  var body = pm.response.json();", "  pm.expect(body).to.have.property('ok');", "  if (body.ok && body.data && body.data.token) pm.environment.set('tokenClinicB', body.data.token);", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "Login clínico - payload inválido",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"invalido\",\n  \"password\": \"\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Campos de login inválidos retornam 400', function () {", "  pm.response.to.have.status(400);", "  pm.expect(pm.response.json().ok).to.eql(false);", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "Selecionar clínica no login",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"selectionToken\": \"{{clinicSelectionToken}}\",\n  \"clinicId\": \"{{clinicId}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login/select-clinic" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Seleção de clínica exige dados válidos e retorna JSON', function () {", "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403]);", "  var body = pm.response.json();", "  pm.expect(body).to.have.property('ok');", "  if (body.ok && body.data && body.data.token) {", "    pm.environment.set('token', body.data.token);", "    pm.environment.set('tokenClinicA', body.data.token);", "  }", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "Sessão atual - sem Bearer",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/auth/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Rota protegida rejeita ausência de token', function () {", "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);", "  pm.expect(pm.response.json().ok).to.eql(false);", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "Sessão atual",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Sessão autenticada retorna usuário', function () {", "  pm.response.to.have.status(200);", "  var body = pm.response.json();", "  pm.expect(body.ok).to.eql(true);", "  pm.expect(body.data).to.have.property('role');", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "Logout clínico",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Logout invalida a sessão atual', function () {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().ok).to.eql(true);", "});"], "type": "text/javascript" } }]
        }
      ]
    },
