          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Cadastro valida permissões, dados e resposta', function () {", "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 401, 403, 409]);", "  var body = pm.response.json();", "  pm.expect(body).to.have.property('ok');", "});"], "type": "text/javascript" } }]
        }
      ]
    },
