          "event": [{ "listen": "test", "script": { "exec": ["pm.test('IDs inválidos são rejeitados', function () {", "  pm.response.to.have.status(400);", "  pm.expect(pm.response.json().ok).to.eql(false);", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "Repetir o mesmo horário para confirmar conflito (escrita)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"professionalId\": \"{{professionalId}}\",\n  \"specialtyId\": \"{{specialtyId}}\",\n  \"serviceId\": \"{{serviceId}}\",\n  \"scheduledStart\": \"{{scheduledStart}}\",\n  \"scheduledEnd\": \"{{scheduledEnd}}\",\n  \"notes\": \"Expected overlapping-slot conflict\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/appointments" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Horário ocupado é recusado', function () {", "  pm.response.to.have.status(409);", "  pm.expect(pm.response.json().ok).to.eql(false);", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "Reagendar agendamento (escrita)",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"professionalId\": \"{{professionalId}}\",\n  \"specialtyId\": \"{{specialtyId}}\",\n  \"serviceId\": \"{{serviceId}}\",\n  \"scheduledStart\": \"{{rescheduledStart}}\",\n  \"scheduledEnd\": \"{{rescheduledEnd}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/appointments/{{appointmentId}}/reschedule" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reagendamento valida resposta e conflito', function () {", "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 403, 404, 409]);", "  pm.expect(pm.response.json()).to.have.property('ok');", "});"], "type": "text/javascript" } }]
        },
