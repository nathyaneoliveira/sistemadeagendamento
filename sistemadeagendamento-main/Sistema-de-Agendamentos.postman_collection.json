          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Cancelamento retorna status de sucesso ou pré-requisito', function () {", "  pm.expect(pm.response.code).to.be.oneOf([200, 403, 404]);", "  pm.expect(pm.response.json()).to.have.property('ok');", "});"], "type": "text/javascript" } }]
